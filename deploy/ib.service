[Unit]
Description=ib simulation trading web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ib
EnvironmentFile=/etc/ib/ib.env
Environment=SERVER_ADDR=127.0.0.1:8081
Environment=RUST_BACKTRACE=1
Environment=DB_PATH=/var/lib/ib/ib.sqlite3
ExecStart=/home/ubuntu/ib/target/release/ib serve 127.0.0.1:8081
Restart=on-failure
RestartSec=5
UMask=027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
LimitNOFILE=65536
StateDirectory=ib

[Install]
WantedBy=multi-user.target
