# Copy to /etc/ib/ib.env and fill in real values.
DB_PATH=/var/lib/ib/ib.sqlite3

# Resend email verification (https://resend.com).
# RESEND_API_KEY empty/missing: verification emails are skipped and
# new accounts stay unverified; nothing else breaks.
RESEND_API_KEY=
# Sender identity, e.g. 'ib <verify@example.com>'. Must use a verified
# domain in production; the default below only delivers to Resend's
# sandbox testing address (delivered@resend.dev).
RESEND_FROM=ib <onboarding@resend.dev>
# Public origin used to build the ?verify_token= link mailed to users,
# e.g. https://ibkr.20070809.xyz (no trailing slash).
APP_BASE_URL=http://127.0.0.1:8081
